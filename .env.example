# streamcount configuration (copy to .env and fill in)
#
# A vision-LLM key is ONLY needed for the `--engine vlm` / `--engine both` modes.
# The local detector mode (`--engine yolo`, the default) runs fully offline at zero API cost.

# Bring your own key (OpenAI-compatible endpoint). Default provider: OpenRouter.
STREAMCOUNT_VLM_KEY=
# OPENROUTER_API_KEY=            # also accepted

STREAMCOUNT_VLM_BASE_URL=https://openrouter.ai/api/v1
STREAMCOUNT_VLM_MODEL=google/gemini-2.5-flash-lite

# Where ONNX models and caches live (default: ~/.cache/streamcount)
# STREAMCOUNT_HOME=
