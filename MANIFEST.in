include README.md LICENSE NOTICE.md CHANGELOG.md CONTRIBUTING.md .env.example
include Dockerfile docker-compose.yml
recursive-include docs *.md
recursive-include examples *.sh *.md
recursive-include scripts *.py
# assets/ (demo GIFs, screenshots) are deliberately NOT shipped in the sdist:
# the README links them by absolute raw URL, so they would only add ~5 MB of dead weight.
recursive-include .github *.yml
global-exclude __pycache__ *.py[cod]
